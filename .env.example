# OpenAI — profile enrichment. Server-only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional. Defaults to gpt-6-luna.
# OPENAI_MODEL=gpt-6-luna

# Ocean.io (server-only — never prefix with NEXT_PUBLIC_)
OCEAN_API_TOKEN=
OCEAN_WEBHOOK_BASE_URL=https://YOUR_PROJECT_REF.supabase.co
OCEAN_WEBHOOK_SECRET=

# Supabase (service role for integration scripts / edge functions)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Supabase browser client. The publishable key is public; row access is still enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (browser + SSR — publishable/anon only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alias accepted by lib/supabase/env.ts:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
